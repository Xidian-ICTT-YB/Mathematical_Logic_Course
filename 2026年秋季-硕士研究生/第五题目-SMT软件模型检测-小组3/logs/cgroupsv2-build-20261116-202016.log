PS C:\Windows\system32> try {
    # 1. 最后确认构建文件
    $dockerfile = Join-Path $project "docker\Dockerfile.benchexec-xml"
    $patch = Join-Path $project "docker\patch-benchexec-cgroupsv2.py"

    if (-not (Test-Path $dockerfile) -or
        -not (Test-Path $patch)) {
        throw "Dockerfile 或补丁文件不存在"
    }

    # 2. 防止覆盖已有镜像标签
    $existing = @(
        docker image ls --format '{{.Repository}}:{{.Tag}}'
    )

    if ($LASTEXITCODE -ne 0) {
        throw "无法检查现有镜像"
    }

    if ($existing -contains $tag) {
        throw "目标镜像标签已经存在，停止覆盖"
    }

    # 3. 构建新镜像
    Write-Host "`n========== 开始构建修复版镜像 ==========" -ForegroundColor Cyan

    $dockerExe = (Get-Command docker.exe).Source

    $arguments = 'build --progress=plain -f "docker\Dockerfile.benchexec-xml" -t "' +
        $tag + '" .'

    $process = Start-Process `
        -FilePath $dockerExe `
        -ArgumentList $arguments `
        -WorkingDirectory $project `
        -NoNewWindow `
        -Wait `
        -PassThru `
        -RedirectStandardOutput $stdout `
        -RedirectStandardError $stderr

    $buildExit = $process.ExitCode

    $outText = [System.IO.File]::ReadAllText($stdout)
    $errText = [System.IO.File]::ReadAllText($stderr)

    Write-Host "`n========== 构建输出 ==========" -ForegroundColor Cyan
    Write-Host $outText
    Write-Host $errText

    if ($buildExit -ne 0) {
        throw "Docker 构建失败，退出码：$buildExit"
    }

    $allText = $outText + "`n" + $errText

    if (-not $allText.Contains("PATCH_APPLIED") -or
        -not $allText.Contains("NONE_HANDLING: VERIFIED")) {
        throw "未找到补丁成功执行标记，不能认定构建成功"
    }

    # 4. 检查最终镜像
    Write-Host "`n========== 检查新镜像 ==========" -ForegroundColor Cyan

    $inspect = & $dockerExe image inspect $tag `
        --format '{{.Id}}|{{.Created}}|{{.Size}}'

    if ($LASTEXITCODE -ne 0) {
        throw "新镜像检查失败"
    }

    $imageInfo = $inspect -join "`n"
    Write-Host $imageInfo

    # 5. 更新中文开发日志
    $backup = "$journal.bak-build-$stamp"
    Copy-Item $journal $backup

    $now = Get-Date -Format "yyyy-MM-dd HH:mm:ss"

    $entry = @"

## $now - BenchExec cgroups v2 修复版镜像构建成功

- 使用原基础镜像 m01-bench-cpa:smoke01。
- 使用 BenchExec 3.26 专用兼容补丁。
- Docker 构建退出码：$buildExit
- 补丁执行标记：PATCH_APPLIED。
- None 内存限制处理验证标记：NONE_HANDLING: VERIFIED。
- 新镜像标签：$tag
- 镜像信息：$imageInfo
- Dockerfile：docker/Dockerfile.benchexec-xml
- Python 补丁：docker/patch-benchexec-cgroupsv2.py
- 构建标准输出：logs/$(Split-Path $stdout -Leaf)
- 构建标准错误：logs/$(Split-Path $stderr -Leaf)
- 完整操作记录：logs/$(Split-Path $transcript -Leaf)
- 开发日志修改前备份：docs/$(Split-Path $backup -Leaf)
- 本次没有运行 CPAchecker 或 BenchExec 实验。
"@

    $oldText = [System.IO.File]::ReadAllText($journal)
    $newText = $oldText.TrimEnd() + "`r`n`r`n" + $entry.Trim() + "`r`n"

    $utf8Bom = [System.Text.UTF8Encoding]::new($true)

    [System.IO.File]::WriteAllText(
        $journal, $newText, $utf8Bom
    )

    Write-Host "`n========== 构建成功 ==========" -ForegroundColor Green
    Write-Host "镜像：$tag"
    Write-Host "开发日志已更新。"
    Write-Host "备份：$backup"
}
finally {
    Stop-Transcript | Out-Null
}

